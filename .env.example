NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SITE_URL=https://jayamanicollections.com
NEXT_PUBLIC_SITE_URL=https://jayamanicollections.com
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_HOST=aws-1-us-east-1.pooler.supabase.com
EASEBUZZ_KEY=your_easebuzz_merchant_key
EASEBUZZ_SALT=your_easebuzz_salt
EASEBUZZ_ENV=prod
EASEBUZZ_URL=https://pay.easebuzz.in
EASEBUZZ_STATUS_URL=https://dashboard.easebuzz.in/transaction/v2.1/retrieve

# DollerpayX / WordPress bridge (runs inside this Next.js app)
# DollerpayX / WordPress call https://<domain>/bosspay/v1/* or /wp-json/bosspay/v1/*
BOSSPAY_BRIDGE_SECRET=change-me-to-a-long-random-string
BOSSPAY_API_BASE=https://dpxreal.com/backend-api

# Optional: run `npm run create-demo-user` to provision a demo account in Supabase Auth
DEMO_LOGIN_EMAIL=demo@jayamanicollections.com
DEMO_LOGIN_PASSWORD=Demo@12345
